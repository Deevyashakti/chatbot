# Copy this file to .env and fill in your own values.

# Claude
ANTHROPIC_API_KEY=
# Only needed for user-scoped keys (sk-ant-usr-...)
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-sonnet-4-5

# Email (Google app password, not your normal password)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com

# Tasks from email
# Comma-separated addresses whose emails become tasks
TASK_MANAGERS=
# Full path to the Excel file. Leave empty to use data\tasks.xlsx in this folder.
TASKS_FILE=
# Sheet (tab) name inside the Excel file. Leave empty to use the first sheet.
TASKS_SHEET=
TASK_CHECK_MINUTES=5

# Weather (RapidAPI)
RAPIDAPI_KEY=
RAPIDAPI_HOST=yahoo-weather5.p.rapidapi.com
